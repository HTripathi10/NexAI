# ─── AI Microservice — Environment Config ────────────────────────────────────
# Copy this file to .env and fill in your values.

# JWT — CHANGE THIS in production! Must be at least 32 chars.
JWT_SECRET_KEY=supersecret-change-in-production-32chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama — local server (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Groq — get your free key at https://console.groq.com
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b

# Token quotas (per user)
DAILY_TOKEN_QUOTA=50000
MONTHLY_TOKEN_QUOTA=500000

# SQLite path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./usage.db

# Debug mode (set to true for SQL echo)
DEBUG=false
